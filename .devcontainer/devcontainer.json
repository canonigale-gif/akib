{
  "name": "Codespace Agentic Hub (OpenCode, Antigravity, Paseo, Telegram)",
  "forwardPorts": [7681, 4096, 6767],
  "portsAttributes": {
    "7681": {
      "label": "ttyd Web Terminal",
      "onAutoForward": "ignore",
      "visibility": "public"
    },
    "4096": {
      "label": "OpenCode Web UI",
      "onAutoForward": "ignore",
      "visibility": "public"
    },
    "6767": {
      "label": "Paseo Agent Web UI",
      "onAutoForward": "ignore",
      "visibility": "public"
    }
  },
  "postStartCommand": "bash /home/codespace/start_all.sh"
}
